{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2021",
    // The extension runs in a web worker wherever VSCode puts it -- a
    // desktop window, a browser tab -- so what it may use is what a
    // browser has, not what Node has. `DOM` is where `Worker`,
    // `WebAssembly` and `TextDecoder` are declared.
    "lib": ["ES2021", "DOM"],
    "outDir": "out",
    "rootDir": "src",
    "strict": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  // the worker is checked against a worker's own globals, which are not
  // a window's: see tsconfig.worker.json
  "exclude": ["src/server.worker.ts"]
}
