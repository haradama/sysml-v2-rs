{
  "name": "sysml-v2",
  "displayName": "SysML v2",
  "description": "SysML v2 / KerML language support: diagnostics, completion, navigation, formatting via sysml-lsp",
  "version": "0.1.0",
  "publisher": "sysml-v2-rs",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/haradama/sysml-v2-rs"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "sysml",
        "aliases": [
          "SysML v2",
          "sysml"
        ],
        "extensions": [
          ".sysml"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "kerml",
        "aliases": [
          "KerML",
          "kerml"
        ],
        "extensions": [
          ".kerml"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "sysml",
        "scopeName": "source.sysml",
        "path": "./syntaxes/sysml.tmLanguage.json"
      },
      {
        "language": "kerml",
        "scopeName": "source.sysml",
        "path": "./syntaxes/sysml.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "SysML v2",
      "properties": {
        "sysml.server.path": {
          "type": "string",
          "default": "",
          "description": "Path to a sysml-lsp executable. Empty uses the server bundled into the extension, falling back to `sysml-lsp` on PATH."
        },
        "sysml.library.path": {
          "type": "string",
          "default": "",
          "description": "Path to a SysML standard library. Empty uses the copy bundled into the extension, falling back to SYSML_LIBRARY_PATH."
        },
        "sysml.workspace.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Directories in the workspace whose models are not part of this project -- a vendored corpus, someone else's model. Their names do not resolve and are not offered in completion. Relative paths are taken from each workspace folder."
        },
        "sysml.preview.openAutomatically": {
          "type": "boolean",
          "default": true,
          "description": "Open the diagram preview beside the editor when a SysML or KerML file is opened. Closing the preview keeps it closed until it is asked for again (`SysML: Open Diagram Preview`)."
        },
        "sysml.diagram.layout": {
          "type": "string",
          "enum": [
            "elk",
            "builtin"
          ],
          "default": "elk",
          "description": "Layout engine for the diagram preview. `elk` runs the `elkrs` command (positions only, the drawing stays the same) and falls back to the built-in layout when it is not installed -- `cargo install elkrs`."
        },
        "sysml.diagram.elk": {
          "type": "string",
          "default": "elkrs",
          "description": "The Eclipse Layout Kernel command the language server runs for diagram layout (`cargo install elkrs`)."
        },
        "sysml.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Log the traffic between VSCode and sysml-lsp in the output channel, for debugging."
        }
      }
    },
    "commands": [
      {
        "command": "sysml.restartServer",
        "title": "SysML: Restart Language Server"
      },
      {
        "command": "sysml.showPreview",
        "title": "SysML: Open Diagram Preview",
        "icon": "$(open-preview)"
      }
    ],
    "configurationDefaults": {
      "[sysml]": {
        "editor.quickSuggestions": {
          "other": "on",
          "comments": "off",
          "strings": "off"
        },
        "editor.suggestOnTriggerCharacters": true,
        "editor.quickSuggestionsDelay": 10,
        "editor.wordBasedSuggestions": "off"
      },
      "[kerml]": {
        "editor.quickSuggestions": {
          "other": "on",
          "comments": "off",
          "strings": "off"
        },
        "editor.suggestOnTriggerCharacters": true,
        "editor.quickSuggestionsDelay": 10,
        "editor.wordBasedSuggestions": "off"
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "sysml.showPreview",
          "when": "resourceLangId == sysml || resourceLangId == kerml",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "package": "vsce package",
    "vscode:prepublish": "npm run compile",
    "test": "npm run compile && node --test test/*.test.mjs"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.75.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.4.0"
  },
  "activationEvents": [
    "onLanguage:sysml",
    "onLanguage:kerml"
  ]
}
