# Created by https://www.toptal.com/developers/gitignore/api/rust,visualstudiocode,linux
# Edit at https://www.toptal.com/developers/gitignore?templates=rust,visualstudiocode,linux

### Linux ###
*~

# temporary files which can be created if a process still has a handle open of a deleted file
.fuse_hidden*

# KDE directory preferences
.directory

# Linux trash folder which might appear on any partition or disk
.Trash-*

# .nfs files are created when an open file is removed but is still being accessed
.nfs*

### Rust ###
# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

### VisualStudioCode ###
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

# Local History for Visual Studio Code
.history/

# Built Visual Studio Code Extensions
*.vsix

### VisualStudioCode Patch ###
# Ignore all local history of files
.history
.ionide

# End of https://www.toptal.com/developers/gitignore/api/rust,visualstudiocode,linux

# local working notes (not part of the repository)
/DESIGN.md
*.svg

# the playground's build artifacts; `web/dist` is built by CI and
# published from there, so nothing about it is tracked
/web/node_modules/
/web/dist/
/web/package-lock.json

# ...except its icon, which `*.svg` above would otherwise take with it
!/web/static/favicon.svg

# VSCode extension build artifacts
/editors/vscode/node_modules/
/editors/vscode/out/
/editors/vscode/package-lock.json
/editors/vscode/*.vsix
/editors/vscode/server/
/editors/vscode/library/
/editors/vscode/LICENSE.txt

# the importer fixture is a standalone crate; only its source is tracked
/crates/sysml-rust/tests/fixtures/*/target/
/crates/sysml-rust/tests/fixtures/*/Cargo.lock

# the example crate builds standalone
/examples/arduino-uno/target/
/examples/arduino-uno/Cargo.lock

# Claude Code's own configuration and the notes written for it are local
# to whoever is working here, not part of the repository. CI runs the
# gates itself -- `.github/workflows/ci.yml` names every command -- so
# nothing here is needed to build, test or release this.
/CLAUDE.md
/.claude/

# how to publish is the maintainer's own runbook, not part of what is
# published
/RELEASING.md
docs/*.pdf
