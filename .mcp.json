{
  "mcpServers": {
    "sysml": {
      "command": "cargo",
      "args": [
        "run",
        "--quiet",
        "--release",
        "--manifest-path",
        "${CLAUDE_PROJECT_DIR}/Cargo.toml",
        "-p",
        "sysml-cli",
        "--",
        "mcp",
        "--library",
        "${CLAUDE_PROJECT_DIR}/vendor/sysml-v2-release/sysml.library"
      ]
    }
  }
}
